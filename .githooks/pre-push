#!/bin/sh
# Personal-data guard over every commit (message and patch) about to be pushed.
# stdin lines: <local_ref> <local_sha> <remote_ref> <remote_sha>
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;; # deletion
  esac
  case "$remote_sha" in
    *[!0]*) range="$remote_sha..$local_sha" ;;
    *) range="$local_sha --not --remotes" ;; # new branch
  esac
  uv run --quiet python scripts/denylist_guard.py --range "$range" || status=1
done
exit $status
